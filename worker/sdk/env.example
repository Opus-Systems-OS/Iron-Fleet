# Copy to worker/sdk/.env (gitignored). Both values come from the Console:
# Workspace > Environments > rig-gpu. The environment id is also in the
# control plane's registry (GET /environments). The key is generated in the
# Console ("Generate environment key") and shown once — it is NOT returned by
# the environments API and the control plane never sees it.
ANTHROPIC_ENVIRONMENT_ID=env_01Tz2CrQM3X4EWDVLGWLY6GH
ANTHROPIC_ENVIRONMENT_KEY=sk-ant-oat01-...

# --- Clipper (agents/clipper.json) ---------------------------------------
# The worker's bash tool inherits this environment, so the clipper session
# reads these directly. Everything here except the API key is an identifier,
# not a secret. Regenerate the key at publish.buffer.com/settings/api.
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=6ab3594a28dc3b70442bafd8
BUFFER_CHANNEL_ID=6ab362e7ea19ca0bdec148dc

# Where finished clips are served from. Buffer fetches the video WHEN THE POST
# PUBLISHES, so this must be public, unauthenticated and stable — never a
# presigned URL. Cloudflare R2 bucket, custom domain in front of it.
CLIPS_BUCKET=clipperzero-clips
CLIPS_PUBLIC_BASE_URL=https://clips.opustower.dev
RCLONE_CONFIG_CLIPS_TYPE=s3
RCLONE_CONFIG_CLIPS_PROVIDER=Cloudflare
RCLONE_CONFIG_CLIPS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_CLIPS_ACCESS_KEY_ID=
RCLONE_CONFIG_CLIPS_SECRET_ACCESS_KEY=
