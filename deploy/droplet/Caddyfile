# Automatic HTTPS (Let's Encrypt, HTTP-01 on :80). All hosts are DNS-only in
# Cloudflare — the proxy must stay off or ACME and the MCP callbacks break.

# Client-facing traffic moved to api.opustower.dev on 2026-09-22 (the API's
# stage 4). Only Anthropic's webhook and the health check UptimeRobot polls
# are served here; everything else 404s. The API and mcp-fleet reach the
# control plane over the compose network, not through this host.
fleet.opustower.dev {
	@open path /webhooks/* /healthz
	handle @open {
		reverse_proxy control-plane:8080
	}
	handle {
		respond 404
	}
	log {
		output file /data/access-fleet.log
	}
}

mcp.opustower.dev {
	reverse_proxy mcp-fleet:8090
	log {
		output file /data/access-mcp.log
	}
}

api.opustower.dev {
	reverse_proxy api:8100
	log {
		output file /data/access-api.log
	}
}

# Opus-VPN's wg-easy admin UI — github.com/Opus-Systems-OS/Opus-VPN, its own
# compose project; its container joins this project's network so Caddy can
# reach it by name. Login (plus wg-easy's own TOTP) is the only gate, and it
# mints VPN keys, so 2FA must stay on. WireGuard itself is 51820/udp, direct;
# WebSocket upgrades go to Opus-VPN's wstunnel instead — WireGuard wrapped in
# HTTPS for networks that block its UDP. wstunnel only forwards to wg-easy's
# WireGuard port, so the WireGuard keys remain the gate.
vpn.opustower.dev {
	header -Server
	@wstunnel {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @wstunnel {
		reverse_proxy wstunnel:8080
	}
	handle {
		reverse_proxy wg-easy:51821
	}
	log {
		output file /data/access-vpn.log
	}
}

# J.A.R.V.I.S. on the web. The site sets its own security headers (CSP with
# Trusted Types, HSTS, COOP/CORP, frame-deny) and runs its own honeypot;
# Caddy terminates TLS, drops its Server banner, and caps bodies at the
# site's largest (a 32 MB chat attachment). Request bodies (the unlock
# passphrase) are never logged — Caddy's access log has no bodies.
jarvis.opustower.dev {
	header -Server
	request_body {
		max_size 34MB
	}
	reverse_proxy jarvis-web:8200
	log {
		output file /data/access-jarvis.log
	}
}
