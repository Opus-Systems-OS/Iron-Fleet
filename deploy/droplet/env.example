# Copy to .env (chmod 600) on the droplet. Never commit .env.
# "cp" = read by control-plane, "mcp" = read by mcp-fleet.
# Token values are the same ones Railway uses; pull them with
#   railway variables -s Iron-Fleet --kv
# and never paste them into a chat or a commit.

# cp
ANTHROPIC_API_KEY=

# cp. The whsec_ shown once when the fleet.opustower.dev endpoint is added
# in Console -> Webhooks. Until then, Railway's value keeps boot happy; only
# deliveries to the droplet need the new one.
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# cp. Only builds the Console trace URL.
ANTHROPIC_WORKSPACE=default

# cp + mcp. Bearer for the control plane's own API.
CONTROL_PLANE_TOKEN=

# cp + mcp. Bearer that jarvis sessions present to mcp-fleet.
MCP_FLEET_TOKEN=

# cp. The PUBLIC URL — Anthropic's sessions call it from outside the box.
MCP_FLEET_URL=https://mcp.opustower.dev/mcp

# cp. blueweb-client's vault credentials + repo mounts (classic PAT) and
# its Cloudflare token.
BLUEWEB_GITHUB_TOKEN=
BLUEWEB_CLOUDFLARE_API_TOKEN=
# cp. jarvis's read-only view of the org: fine-grained, Opus-Systems-OS,
# Contents: read-only. Mounted repos + `gh` (GH_TOKEN, api.github.com only).
JARVIS_GITHUB_READ_TOKEN=

# cp. Phase 6: the rig's Ollama over the tailnet (deploy/rig/README.md).
# Unset = the /inference/* routes are not registered at all. Rig off = 503.
# Never a public address; only a 100.x tailnet IP belongs here.
#INFERENCE_URL=http://<rig tailnet IP>:11434

# cp
# Converge agents/ onto Anthropic at boot. A failed sync logs an ERROR and
# the control plane serves the last synced registry anyway; false skips the
# API entirely at boot (restore tests, credit outages).
SYNC_ON_BOOT=true

# cp + mcp
RUST_LOG=info,tower_http=info

# --- opus-api: the ops panels (read-only tokens, any subset) --------------
# See Opus-Systems-OS-API/deploy/env.example for what each token needs.
#UPTIMEROBOT_API_KEY=
#TAILSCALE_API_KEY=
#CLOUDFLARE_API_TOKEN=
#DIGITALOCEAN_TOKEN=
#GITHUB_TOKEN=
DOCKER_SOCKET=/var/run/docker.sock

# --- jarvis-web (jarvis.opustower.dev) --------------------------------------
# Only these reach the jarvis-web container (no env_file there).
# Its own API key: opus-api keys create --name web --scopes fleet:read,sessions:read,sessions:write,usage:read,voice,ops:read,inference
#WEB_API_KEY=
# From `docker compose run --rm jarvis-web hash-password`. Single quotes:
# the hash contains `$`.
#JARVIS_WEB_PASSWORD_HASH='$argon2id$v=19$…'
