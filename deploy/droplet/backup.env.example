# Copy to backup.env (chmod 600) on the droplet. Never commit backup.env.
# Read only by backup.sh (via the systemd unit) — the containers never see it.
# The restore side (the Mac) needs the same R2 values plus the age *identity*;
# keep both in the Mac's secret store.

# The age recipient (public key, "age1…") from `age-keygen` run on the Mac.
# The matching identity (AGE-SECRET-KEY-1…) never comes to this box.
AGE_RECIPIENT=

# Cloudflare R2, S3 API. One bucket, one token scoped to it
# (Object Read & Write). rclone reads these as its whole config — there is
# no rclone.conf. Endpoint is https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=iron-fleet-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_ACL=private

# Days of nightly objects to keep in the bucket.
RETENTION_DAYS=30
